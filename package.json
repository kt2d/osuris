{
  "name": "osuris",
  "version": "0.1.0",
  "type": "module",
  "description": "Horizontal compression puzzle game",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "postbuild": "cp index.html dist/ && sed -i 's|src=\"./src/entry.js\"|src=\"entry.js\"|' dist/index.html",
    "dev": "vite dev",
